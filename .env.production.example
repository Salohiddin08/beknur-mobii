# Copy to .env.production on the server. Never commit real secrets.
# Use a long random HEX password (URL-safe).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SITE_HOST=REPLACE_WITH_DOMAIN
APP_ORIGIN=https://REPLACE_WITH_DOMAIN
# Keep false until the real domain and public content are verified.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
